# No versionar Moodle completo local
/moodle/*
!/moodle/.gitkeep
!/moodle/reportes/
/moodle/reportes/*
!/moodle/reportes/reporteTPporCurso.php

# No versionar moodledata
/moodledata/*
!/moodledata/.gitkeep

# No versionar dumps de base de datos
/db-dumps/*
!/db-dumps/.gitkeep

# Backups y comprimidos
*.sql
*.sql.gz
*.zip
*.tar
*.tar.gz
*.tgz
*.bak

# Configuración sensible
config.php
.env
*.env

# Cachés y temporales Moodle
cache/
localcache/
temp/
sessions/
trashdir/

# Logs
*.log

# Sistema / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
# Local AI runtime state
.atl/
